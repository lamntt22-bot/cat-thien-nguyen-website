# Copy file này thành .env.local (KHÔNG commit .env.local) và điền giá trị thật.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key — CHỈ dùng ở server, không lộ ra frontend

# Chuỗi bí mật để ký session token (JWT). Tạo 1 chuỗi ngẫu nhiên dài, ví dụ chạy:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
